{
  "name": "portfolio",
  "version": "0.1.0",
  "author": "Aidan Lowson <dev@aidanlowson.com>",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AidanLDev/Portfolio.git"
  },
  "scripts": {
    "build": "next build --webpack",
    "dev": "next dev",
    "lint": "biome check",
    "start": "npx serve@latest out",
    "deploy": "npx sst deploy --stage production",
    "refresh": "npx sst refresh --stage production",
    "format": "biome format --write",
    "format:check": "biome format",
    "postbuild": "next-sitemap",
    "test:e2e": "playwright test",
    "test:e2e-open": "playwright test --ui",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1119.0",
    "@aws-sdk/client-ses": "^3.1119.0",
    "@aws-sdk/lib-dynamodb": "^3.1119.0",
    "@next/third-parties": "^16.3.4",
    "@sentry/nextjs": "^10.71.0",
    "motion": "^12.43.0",
    "next": "^16.3.4",
    "next-sitemap": "^4.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass": "^1.103.1",
    "sst": "^4.17.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^16.4.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json,css,md}": "biome format --write"
  }
}
